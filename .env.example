# Copy to .env. Never commit .env — TRD 12.5.

POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# The control database — tenant registry and routing only (ADR-017).
GL_CONTROL_DB_NAME=gl_control
GL_CONTROL_DB_URL=postgresql+psycopg://guardian:guardian@localhost:5432/gl_control

# One database per tenant (ADR-016). Set per invocation; the provisioning
# path derives the name as gl_tenant_<slug>.
GL_TENANT_DB_URL=postgresql+psycopg://guardian:guardian@localhost:5432/gl_tenant_pilot

# Database used by the bypass suite. Dropped and recreated on each run.
GL_TEST_DB_URL=postgresql+psycopg://guardian:guardian@localhost:5432/gl_tenant_test

# Comma-separated browser origins allowed to call the API (TRD 12.1 allowlist).
GL_CORS_ORIGINS=http://localhost:5173

# Review-UI dev-server port for `make run` (default 5173). Override when
# another project's dev server owns 5173 — and add the matching origin to
# GL_CORS_ORIGINS above.
#GL_WEB_PORT=5173

# Token lifetimes in seconds — TRD 12.2 defaults shown. The access token is
# renewed silently via the refresh token, so the refresh TTL is what bounds
# how long a signed-in session (including across page reloads) can last.
GL_ACCESS_TOKEN_TTL_SECONDS=900
GL_REFRESH_TOKEN_TTL_SECONDS=604800
GL_AGENT_TOKEN_TTL_SECONDS=900

# Camera-credential sealing (TRD 12.4). 32-byte hex; the SAME key must be
# present at the control plane (seals) and the edge (unseals). make run
# generates and persists one automatically if absent.
GL_CAMERA_KEY=
GL_CAMERA_KEY_ID=dev-key-1
